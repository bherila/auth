{
  "name": "bwh-auth",
  "version": "0.1.1",
  "description": "Shared React auth UI and browser WebAuthn helpers for BWH applications.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.4.1",
    "lucide-react": ">=0.468.0 <1.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
